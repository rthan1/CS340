# ============================================================
# Black Hole Simulation - Semi-Realistic 2D Gravitational Demo
# ============================================================
# A beautiful visualization of particles orbiting and falling
# into a black hole with Newtonian gravitational physics.
#
# Click "Run Graphics" to see the simulation!
# ============================================================

# --- Physics Constants ---
integer GM = 6000
integer centerX = 400
integer centerY = 225
integer softening = 64

# --- Temporary variables for physics calculations ---
integer dx = 0
integer dy = 0
integer r2 = 0
integer r = 0
integer r3 = 0
integer ax = 0
integer ay = 0

# --- Frame counter ---
integer frame = 0

# --- Background Stars (static) ---
integer s1x = 45
integer s1y = 35
integer s2x = 145
integer s2y = 75
integer s3x = 695
integer s3y = 55
integer s4x = 595
integer s4y = 375
integer s5x = 95
integer s5y = 345
integer s6x = 745
integer s6y = 195
integer s7x = 25
integer s7y = 175
integer s8x = 765
integer s8y = 395
integer s9x = 300
integer s9y = 30
integer s10x = 500
integer s10y = 420

# === ACCRETION DISC PARTICLES ===
integer d1x = 330
integer d1y = 225
integer d1vx = 0
integer d1vy = 260

integer d2x = 470
integer d2y = 225
integer d2vx = 0
integer d2vy = 0

integer d3x = 400
integer d3y = 155
integer d3vx = 260
integer d3vy = 0

integer d4x = 400
integer d4y = 295
integer d4vx = 0
integer d4vy = 0

integer d5x = 350
integer d5y = 175
integer d5vx = 185
integer d5vy = 185

integer d6x = 450
integer d6y = 275
integer d6vx = 0
integer d6vy = 0

# === OUTER ORBITING STARS ===
