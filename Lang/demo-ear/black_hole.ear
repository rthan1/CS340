integer o1y = 225
integer o1vx = 0
integer o1vy = 175

integer o2x = 540
integer o2y = 225
integer o2vx = 0
integer o2vy = 0

integer o3x = 400
integer o3y = 105
integer o3vx = 190
integer o3vy = 0

integer o4x = 400
integer o4y = 345
integer o4vx = 0
integer o4vy = 0

# === INFALLING PARTICLES ===
integer i1x = 300
integer i1y = 170
integer i1vx = 70
integer i1vy = 50

integer i2x = 500
integer i2y = 280
integer i2vx = 0
integer i2vy = 0

# === STATIC POSITIONS ===
integer ringX = 400
integer ringY = 225
integer glowX = 400
integer glowY = 225
integer holeX = 400
integer holeY = 225

# === SETUP FUNCTION ===
func setup():
    # Initialize negative velocities (can't do in declarations)
    d2vy = 0 - 260
    d4vx = 0 - 260
    d6vx = 0 - 185
    d6vy = 0 - 185
    o2vy = 0 - 175
    o4vx = 0 - 190
    i2vx = 0 - 70
    i2vy = 0 - 50
    
    # Initialize renderer
    Renderer.init(800, 450)
    Renderer.background(3, 3, 12)
    
    # Draw background stars
    Renderer.draw("circle", s1x, s1y, size=1, r=180, g=180, b=200)
    Renderer.draw("circle", s2x, s2y, size=2, r=160, g=160, b=180)
    Renderer.draw("circle", s3x, s3y, size=1, r=200, g=200, b=230)
    Renderer.draw("circle", s4x, s4y, size=2, r=170, g=170, b=190)
    Renderer.draw("circle", s5x, s5y, size=1, r=160, g=160, b=180)
    Renderer.draw("circle", s6x, s6y, size=1, r=190, g=190, b=220)
    Renderer.draw("circle", s7x, s7y, size=2, r=175, g=175, b=195)
    Renderer.draw("circle", s8x, s8y, size=1, r=165, g=165, b=185)
    Renderer.draw("circle", s9x, s9y, size=1, r=200, g=200, b=230)
    Renderer.draw("circle", s10x, s10y, size=2, r=180, g=180, b=200)
    
    # Draw accretion disc (hot orange/yellow glow)
    Renderer.draw("circle", d1x, d1y, size=4, r=255, g=180, b=60)
    Renderer.draw("circle", d2x, d2y, size=4, r=255, g=160, b=40)
    Renderer.draw("circle", d3x, d3y, size=3, r=255, g=200, b=80)
    Renderer.draw("circle", d4x, d4y, size=4, r=255, g=140, b=30)
    Renderer.draw("circle", d5x, d5y, size=3, r=255, g=190, b=70)
    Renderer.draw("circle", d6x, d6y, size=3, r=255, g=170, b=50)
    
    # Draw outer orbiters (cool blue-white)
    Renderer.draw("circle", o1x, o1y, size=5, r=160, g=190, b=255)
    Renderer.draw("circle", o2x, o2y, size=5, r=180, g=210, b=255)
    Renderer.draw("circle", o3x, o3y, size=4, r=140, g=170, b=255)
    Renderer.draw("circle", o4x, o4y, size=4, r=170, g=200, b=255)
    
    # Draw infallers (reddish)
    Renderer.draw("circle", i1x, i1y, size=3, r=255, g=90, b=90)
    Renderer.draw("circle", i2x, i2y, size=3, r=255, g=110, b=110)
    
    # Draw photon ring
    Renderer.draw("circle", ringX, ringY, size=42, r=255, g=230, b=180)
    
    # Draw inner glow
    Renderer.draw("circle", glowX, glowY, size=34, r=200, g=150, b=100)
    
    # Draw event horizon (black hole)
    Renderer.draw("circle", holeX, holeY, size=26, r=0, g=0, b=0)

# === UPDATE FUNCTION ===
func update():
    # === Update Disc Particle 1 ===
    dx = d1x - centerX
    dy = d1y - centerY
    r2 = dx * dx + dy * dy + softening
    r = 70
    r = (r + r2 / r) / 2
    r = (r + r2 / r) / 2
    r = (r + r2 / r) / 2
    if (r < 15):
        r = 15
    r3 = r * r * r / 10000
    if (r3 < 1):
        r3 = 1
    ax = 0 - GM * dx / r3 / 100
    ay = 0 - GM * dy / r3 / 100
    d1vx = d1vx + ax
    d1vy = d1vy + ay
    d1x = d1x + d1vx / 100
    d1y = d1y + d1vy / 100
    if (r < 35):
        d1x = 330
        d1y = 225
        d1vx = 0
        d1vy = 260
    
    # === Update Disc Particle 2 ===
    dx = d2x - centerX
    dy = d2y - centerY
    r2 = dx * dx + dy * dy + softening
    r = 70
    r = (r + r2 / r) / 2
